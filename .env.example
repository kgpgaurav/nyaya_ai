# Copy to .env, then replace the API key with your own secret.
# Never commit .env or post real keys in a public issue.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
OPENAI_API_KEY=sk-your-key-here

# Use the same OpenAI key for speech-to-text, or set STT_PROVIDER=none.
STT_PROVIDER=openai
STT_MODEL=whisper-1

# Full-text search is enabled without embeddings or additional API cost.
EMBEDDING_PROVIDER=none
EMBEDDING_MODEL=

# This URL works inside Docker Compose; Compose explicitly supplies it to API.
DATABASE_URL=postgresql+psycopg://nyaya:nyaya@db:5432/nyaya
COOKIE_SECURE=false
SESSION_TTL_HOURS=72
MAX_CALLS_PER_CASE=60
MAX_CALLS_PER_DAY=1500

# Optional alternative providers. Leave empty when using OpenAI.
GROQ_API_KEY=
GOOGLE_API_KEY=
SARVAM_API_KEY=
OLLAMA_BASE_URL=http://ollama:11434
